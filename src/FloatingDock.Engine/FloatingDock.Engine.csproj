<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FloatingDock engine: the windowless process that owns everything system-related (settings, pinned apps, running windows, media)
    and serves it to the UI processes over IPC. It has no UI of its own.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>FloatingDock.Engine</AssemblyName>
    <RootNamespace>FloatingDock.Engine</RootNamespace>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Like the dock itself: no .NET install is required on the user's machine. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Description>FloatingDock engine</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\FloatingDock.App\Assets\Explorer.png" Link="Assets\Explorer.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\FloatingDock.App\Assets\AppIcon.png" Link="Assets\AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FloatingDock.Core\FloatingDock.Core.csproj" />
    <ProjectReference Include="..\FloatingDock.Windows\FloatingDock.Windows.csproj" />
    <ProjectReference Include="..\FloatingDock.Ipc\FloatingDock.Ipc.csproj" />
  </ItemGroup>

</Project>
